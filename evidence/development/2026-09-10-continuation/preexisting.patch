+/// Caller context solve parameter seeds: positional match between the callee's
+/// declared parameters and the recorded actual argument values.
+fn context_seeds(function: &FlowFunction, args: &[Value]) -> Vec<(String, Value)> {
+    function
+        .params
+        .iter()
+        .zip(args.iter())
+        .map(|(binding, value)| (binding.clone(), value.clone()))
+        .collect()
 }
