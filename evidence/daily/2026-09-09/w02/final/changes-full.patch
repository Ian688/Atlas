                        expr: expr(
                            12,
                            30,
                            ExprKind::Assign {
                                op: "=".into(),
                                target: AssignTarget::Binding { binding: g.into() },
                                value: Box::new(funcref("symbol:f.ts:0:99:b")),
                            },
                        ),
                    },
                )],
                catch_param: None,
