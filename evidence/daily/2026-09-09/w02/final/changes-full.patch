#[derive(Clone, Debug, Serialize)]
pub struct OpOut {
    pub index: u32,
    pub kind: String,
    pub detail: String,
    pub start: usize,
    pub end: usize,
    pub may_throw: bool,
}

#[derive(Clone, Debug, Serialize)]
pub struct BlockOut {
    pub id: u32,
    pub term: String,
    pub successors: Vec<(u32, String)>,
    pub ops: Vec<u32>,
}

#[derive(Clone, Debug, Serialize)]
pub struct PrunedEdgeOut {
    pub cond: u32,
    pub to: u32,
    pub reason: String,
}

#[derive(Clone, Debug, Serialize)]
pub struct BlockStateJson {
    pub block: u32,
    pub completion: String,
    pub bindings: Vec<BindingStateJson>,
    pub truncated: bool,
}

#[derive(Clone, Debug, Serialize)]
pub struct BindingStateJson {
    pub binding: String,
    pub name: String,
    pub init: String,
    pub defs: Vec<u32>,
    pub value: solve::ValueJson,
}

#[derive(Clone, Debug, Serialize)]
pub struct DefUseJson {
    pub binding: String,
    pub name: String,
    pub defs: Vec<u32>,
    pub uses: Vec<UseJson>,
}

#[derive(Clone, Debug, Serialize)]
pub struct UseJson {
