fn scc_handles_deep_graph_without_recursion_and_reports_cycles() {
    let edges: Vec<_> = (0..10000)
        .map(|n| Edge {
            id: n.to_string(),
            source: n.to_string(),
            target: Some(((n + 1) % 10000).to_string()),
